{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SecureVault (real data)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "SecureVault (throwaway test vault)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": { "SECUREVAULT_DATA_DIR": "${workspaceFolder}/.devdata" }
        },
        {
            "name": "Run tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-q"],
            "cwd": "${workspaceFolder}",
            "env": { "QT_QPA_PLATFORM": "offscreen" },
            "console": "integratedTerminal"
        }
    ]
}
